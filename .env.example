# --- Database (Supabase Postgres) ---
# Runtime: Supabase "Transaction pooler" connection string (port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres"
# Optional, Prisma CLI migrations: "Direct connection" / session pooler (port 5432)
# DIRECT_URL="postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- Access protection (recommended when deployed) ---
APP_PASSWORD=""
# Optional: random string; changing it logs out all sessions
AUTH_SECRET=""

# --- AI (optional; the site works without it) ---
# AI_PROVIDER="anthropic"   # or "openai"
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4.1-mini"
